# Local application configuration.
MODEL_PROVIDER=groq
GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
EXTRACTION_MODEL=openai/gpt-oss-20b
APP_TIMEZONE=Asia/Kolkata
APP_HOST=127.0.0.1
APP_PORT=7861
# The Groq free-tier speech-to-text attachment limit is 25 MB.
MAX_AUDIO_BYTES=26214400

# Real-time voice companion. Create a LiveKit project (or run a local LiveKit
# server) and copy its connection credentials here. These stay on your machine.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_AGENT_NAME=loose-ends-voice
VOICE_STT_MODEL=whisper-large-v3-turbo
VOICE_STT_LANGUAGE=en
VOICE_LLM_MODEL=openai/gpt-oss-20b
# Streaming speech through LiveKit Inference; uses the existing LiveKit project.
VOICE_TTS_MODEL=cartesia/sonic-3
VOICE_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# Configure Kane authentication via its documented setup; never commit credentials.
